---
import Section from './Section.astro';
import SectionNumber from './SectionNumber.astro';
import Icon from './Icon.astro';
import Figure from './Figure.astro';
import { gallery } from '../data/images';
---

<Section id="momentos" bg="stone">
  <div class="relative">
    <SectionNumber number="05" class="absolute -top-6 left-0 text-[3rem] sm:-top-12 sm:text-[6rem] lg:text-[9rem]" />

    <div class="relative mb-10 flex flex-wrap items-end justify-between gap-6">
      <div class="max-w-2xl">
        <p data-reveal class="mb-3 text-sm font-medium uppercase tracking-wider text-clay">
          Momentos
        </p>
        <h2 data-reveal class="text-3xl font-semibold leading-tight sm:text-4xl">
          Así acompañamos, en imágenes
        </h2>
      </div>

      <div data-reveal class="flex gap-2.5">
        <button
          type="button"
          data-gallery-prev
          class="inline-flex h-11 w-11 items-center justify-center rounded-full border border-line bg-paper text-summit transition-all hover:border-summit hover:bg-summit hover:text-paper disabled:opacity-40"
          aria-label="Foto anterior"
        >
          <Icon name="arrow-right" class="h-5 w-5 rotate-180" />
        </button>
        <button
          type="button"
          data-gallery-next
          class="inline-flex h-11 w-11 items-center justify-center rounded-full border border-line bg-paper text-summit transition-all hover:border-summit hover:bg-summit hover:text-paper disabled:opacity-40"
          aria-label="Foto siguiente"
        >
          <Icon name="arrow-right" class="h-5 w-5" />
        </button>
      </div>
    </div>

    <div
      data-gallery-track
      data-reveal
      class="-mx-6 flex snap-x snap-mandatory gap-4 overflow-x-auto scroll-smooth px-6 pb-4 sm:-mx-8 sm:px-8 [scrollbar-width:none] [&::-webkit-scrollbar]:hidden"
    >
      {
        gallery.map((photo) => (
          <div class="group relative w-[80%] shrink-0 snap-center sm:w-[46%] lg:w-[32%]">
            <Figure
              src={photo.src}
              ratio="4/3"
              accent="sage"
              icon="image"
              alt={photo.alt}
              class="shadow-soft transition-transform duration-300 group-hover:-translate-y-1"
            />
            {photo.caption && (
              <span class="absolute bottom-3 left-3 rounded-full bg-summit-deep/80 px-3 py-1 text-xs font-medium text-stone backdrop-blur-sm">
                {photo.caption}
              </span>
            )}
          </div>
        ))
      }
    </div>
  </div>
</Section>

<script>
  function initGallery() {
    const track = document.querySelector<HTMLElement>('[data-gallery-track]');
    const prev = document.querySelector<HTMLButtonElement>('[data-gallery-prev]');
    const next = document.querySelector<HTMLButtonElement>('[data-gallery-next]');
    if (!track || !prev || !next) return;

    const step = () => {
      const card = track.querySelector<HTMLElement>(':scope > div');
      return card ? card.offsetWidth + 16 : track.clientWidth * 0.8;
    };
    const update = () => {
      const max = track.scrollWidth - track.clientWidth - 1;
      prev.disabled = track.scrollLeft <= 1;
      next.disabled = track.scrollLeft >= max;
    };
    prev.addEventListener('click', () => track.scrollBy({ left: -step(), behavior: 'smooth' }));
    next.addEventListener('click', () => track.scrollBy({ left: step(), behavior: 'smooth' }));
    track.addEventListener('scroll', update, { passive: true });
    window.addEventListener('resize', update, { passive: true });
    update();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initGallery);
  } else {
    initGallery();
  }
</script>
