---
import ContourBackground from './ContourBackground.astro';
import MountainParallax from './MountainParallax.astro';
import ContactForm from './ContactForm.astro';
---

<section id="contacto" class="relative overflow-hidden">
  <!-- Cielo amanecer luminoso -->
  <div
    class="absolute inset-0 -z-10"
    style="background:linear-gradient(180deg, #FBFAF7 0%, #F4F1EC 45%, #F6EBE2 75%, #F3DECB 100%)"
  >
  </div>

  <!-- Curvas de nivel muy tenues + cumbre clara con parallax -->
  <ContourBackground class="-z-10" color="var(--mist)" opacity={0.25} />
  <MountainParallax variant="hero" class="-z-10" />

  <div class="container-page relative py-24 sm:py-32">
    <div class="mx-auto max-w-3xl text-center">
      <h2
        data-reveal
        class="font-serif text-4xl font-semibold leading-[1.1] text-summit sm:text-5xl lg:text-6xl"
      >
        Porque ninguna cima<br />se alcanza sola.
      </h2>
      <p data-reveal data-reveal-stagger="120" class="mt-6 text-lg text-ink/70 sm:text-xl">
        ¿Conversamos sobre el próximo desafío de tu organización?
      </p>
    </div>

    <div data-reveal data-reveal-stagger="200" class="mx-auto mt-12 max-w-2xl">
      <ContactForm />
    </div>
  </div>
</section>
