---
import Section from './Section.astro';
import SectionNumber from './SectionNumber.astro';
import Icon from './Icon.astro';
import { resources } from '../data/resources';

const typeIcon: Record<string, string> = {
  article: 'file-text',
  video: 'play',
  podcast: 'mic',
};
---

<Section id="recursos" bg="paper">
  <div class="relative">
    <SectionNumber number="06" class="absolute -top-6 right-0 text-[3rem] sm:-top-12 sm:text-[6rem] lg:text-[9rem]" />

    <div class="relative mb-10 max-w-2xl">
      <p data-reveal class="mb-3 text-sm font-medium uppercase tracking-wider text-summit">
        En los medios
      </p>
      <h2 data-reveal class="text-3xl font-semibold leading-tight sm:text-4xl">
        Recursos y publicaciones
      </h2>
    </div>

    <div class="grid gap-4 sm:grid-cols-2">
      {
        resources.map((r, i) => (
          <a
            href={r.url}
            target="_blank"
            rel="noopener noreferrer"
            data-reveal
            data-reveal-stagger={i * 70}
            class="group flex items-center gap-3.5 rounded-xl border border-line bg-stone p-4 transition-all duration-300 ease-smooth hover:-translate-y-0.5 hover:border-summit/30 hover:shadow-soft sm:gap-4 sm:rounded-2xl sm:p-5"
          >
            <span class="inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-summit/8 text-summit transition-colors group-hover:bg-summit group-hover:text-paper sm:h-11 sm:w-11 sm:rounded-xl">
              <Icon name={typeIcon[r.type]} class="h-5 w-5" />
            </span>
            <span class="min-w-0 flex-1">
              <span class="block text-[0.7rem] font-medium uppercase tracking-wider text-clay sm:text-xs">
                {r.typeLabel} · {r.source}
              </span>
              <span class="mt-0.5 block truncate text-sm font-medium text-ink sm:text-base">{r.title}</span>
            </span>
            <Icon
              name="arrow-up-right"
              class="h-5 w-5 shrink-0 text-ink/40 transition-all group-hover:-translate-y-0.5 group-hover:translate-x-0.5 group-hover:text-summit"
            />
          </a>
        ))
      }
    </div>
  </div>
</Section>
