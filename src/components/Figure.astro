---
// Imagen con placeholder elegante y carga tolerante a fallos.
// - Si `src` existe y el archivo carga → muestra la foto.
// - Si `src` no existe todavía (aún no subes el archivo) → muestra el placeholder
//   cálido automáticamente (sin imagen rota), gracias al onerror.
// Sube tus fotos a /public/images con el nombre indicado en cada `src`.
import Icon from './Icon.astro';

interface Props {
  src?: string;
  alt?: string;
  ratio?: string; // p.ej. "4/3", "1/1", "3/4", "16/9"
  accent?: 'summit' | 'clay' | 'sage' | 'amber';
  icon?: string;
  label?: string;
  position?: string; // object-position del recorte, p.ej. "center 35%"
  class?: string;
}
const {
  src,
  alt = '',
  ratio = '4/3',
  accent = 'summit',
  icon = 'image',
  label,
  position = 'center',
  class: className = '',
} = Astro.props;

const accents: Record<string, string> = {
  summit: 'linear-gradient(135deg, #3A4CC4 0%, #4A5DE0 55%, #AEB6DC 100%)',
  clay: 'linear-gradient(135deg, #D2691E 0%, #F5933B 55%, #F6DFC7 100%)',
  sage: 'linear-gradient(135deg, #5A6DF0 0%, #AEB6DC 60%, #F4F1EC 100%)',
  amber: 'linear-gradient(135deg, #E67E30 0%, #F2A65A 55%, #F6E3C9 100%)',
};
---

<figure class={`relative overflow-hidden rounded-2xl ${className}`} style={`aspect-ratio:${ratio}`}>
  {/* Placeholder cálido (siempre presente, detrás de la imagen) */}
  <div
    class="grain absolute inset-0 flex flex-col items-center justify-center gap-2 text-paper/90"
    style={`background:${accents[accent]}`}
    role="img"
    aria-label={alt || label || 'Imagen pendiente'}
  >
    <Icon name={icon} class="h-9 w-9 opacity-80" />
    {label && <span class="text-xs font-medium uppercase tracking-wider opacity-80">{label}</span>}
  </div>

  {/* Imagen real: si el archivo no existe aún, onerror la oculta y se ve el placeholder */}
  {
    src && (
      <img
        src={src}
        alt={alt}
        loading="lazy"
        decoding="async"
        class="absolute inset-0 h-full w-full object-cover"
        style={`object-position:${position}`}
        onerror="this.style.display='none'"
      />
    )
  }
</figure>
