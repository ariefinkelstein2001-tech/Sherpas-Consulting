---
// Banda de fotografía protagonista con una frase corta encima (estilo editorial).
import Figure from './Figure.astro';
import { images } from '../data/images';
---

<section class="relative overflow-hidden" aria-label="Nuestra forma de trabajar">
  <div class="relative">
    <Figure
      src={images.approachWide}
      ratio="16/9"
      accent="sage"
      icon="users"
      label="Foto de un taller"
      alt="Taller de Sherpas Consulting con un equipo de trabajo"
      class="!rounded-none max-h-[70vh]"
    />
    <!-- Degradé para legibilidad del texto -->
    <div
      class="pointer-events-none absolute inset-0"
      style="background:linear-gradient(90deg, rgba(10,54,63,0.72) 0%, rgba(10,54,63,0.35) 45%, transparent 75%)"
      aria-hidden="true"
    >
    </div>
    <div class="absolute inset-0 flex items-center">
      <div class="container-page">
        <p data-reveal class="max-w-lg font-serif text-2xl font-medium leading-snug text-stone sm:text-3xl md:text-4xl">
          El desarrollo real ocurre en el día a día: en las conversaciones, decisiones y hábitos de
          cada equipo.
        </p>
      </div>
    </div>
  </div>
</section>
