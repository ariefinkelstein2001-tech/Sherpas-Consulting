---
import Section from './Section.astro';
import SectionNumber from './SectionNumber.astro';
import PrincipleCard from './PrincipleCard.astro';
import { principles } from '../data/principles';
---

<Section id="brujula" bg="stone">
  <div class="relative">
    <SectionNumber number="02" class="absolute -top-12 left-0 text-[7rem] sm:text-[10rem]" />

    <div class="relative mb-12 max-w-2xl">
      <p data-reveal class="mb-3 text-sm font-medium uppercase tracking-wider text-clay">
        Cómo acompañamos
      </p>
      <h2 data-reveal class="mb-5 text-3xl font-semibold leading-tight sm:text-4xl">
        La brújula que guía nuestra forma de acompañar
      </h2>
      <p data-reveal class="text-lg leading-relaxed text-ink/75">
        Cuatro principios que orientan cada proyecto: soluciones con sentido, cercanas a tu realidad
        y enfocadas en generar impacto concreto.
      </p>
    </div>

    <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
      {
        principles.map((p, i) => (
          <PrincipleCard
            {...p}
            stagger={i * 90}
            accent={(['summit', 'clay', 'amber', 'sage'] as const)[i % 4]}
          />
        ))
      }
    </div>
  </div>
</Section>
