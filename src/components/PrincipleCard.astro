---
import Icon from './Icon.astro';
import type { Principle } from '../data/principles';

interface Props extends Principle {
  stagger?: number;
}
const { icon, title, body, stagger = 0 } = Astro.props;
---

<article
  data-reveal
  data-reveal-stagger={stagger}
  class="principle-card group relative overflow-hidden rounded-2xl border border-line bg-paper p-7 transition-all duration-300 ease-smooth hover:-translate-y-1 hover:shadow-lift"
>
  <!-- Línea superior en --clay al hover -->
  <span
    class="absolute inset-x-0 top-0 h-0.5 origin-left scale-x-0 bg-clay transition-transform duration-300 ease-smooth group-hover:scale-x-100"
  ></span>

  <span
    class="mb-5 inline-flex h-12 w-12 items-center justify-center rounded-xl bg-summit/8 text-summit transition-colors duration-300 group-hover:bg-summit group-hover:text-paper"
  >
    <Icon name={icon} class="h-6 w-6" />
  </span>

  <h3 class="mb-2.5 text-xl font-semibold">{title}</h3>
  <p class="text-[0.975rem] leading-relaxed text-ink/70">{body}</p>
</article>
