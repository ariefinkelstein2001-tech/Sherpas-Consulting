---
import Icon from './Icon.astro';
import type { Principle } from '../data/principles';

interface Props extends Principle {
  stagger?: number;
  accent?: 'summit' | 'clay' | 'sage' | 'amber';
}
const { icon, title, body, stagger = 0, accent = 'summit' } = Astro.props;

const accents: Record<string, { tint: string; chip: string; bar: string }> = {
  summit: { tint: 'rgba(15,76,92,0.05)', chip: 'bg-summit/12 text-summit', bar: 'bg-summit' },
  clay: { tint: 'rgba(196,106,75,0.07)', chip: 'bg-clay/15 text-clay', bar: 'bg-clay' },
  amber: { tint: 'rgba(224,164,88,0.12)', chip: 'bg-[#E0A458]/20 text-[#b97c2f]', bar: 'bg-[#E0A458]' },
  sage: { tint: 'rgba(92,123,120,0.10)', chip: 'bg-mist/30 text-summit-deep', bar: 'bg-[#5c7b78]' },
};
const a = accents[accent];
---

<article
  data-reveal
  data-reveal-stagger={stagger}
  class="group relative overflow-hidden rounded-2xl border border-line p-7 transition-all duration-300 ease-smooth hover:-translate-y-1 hover:shadow-lift"
  style={`background:${a.tint}`}
>
  <span class={`absolute inset-x-0 top-0 h-1 origin-left scale-x-0 transition-transform duration-300 ease-smooth group-hover:scale-x-100 ${a.bar}`}></span>

  <span class={`mb-5 inline-flex h-12 w-12 items-center justify-center rounded-xl transition-transform duration-300 group-hover:-rotate-6 group-hover:scale-105 ${a.chip}`}>
    <Icon name={icon} class="h-6 w-6" />
  </span>

  <h3 class="mb-2.5 text-xl font-semibold">{title}</h3>
  <p class="text-[0.95rem] leading-relaxed text-ink/70">{body}</p>
</article>
