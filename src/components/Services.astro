---
import Section from './Section.astro';
import SectionNumber from './SectionNumber.astro';
import Icon from './Icon.astro';
import { services } from '../data/services';

// Tintes cálidos por acento (fondo suave + chip de ícono).
const accentStyles: Record<string, { tint: string; chip: string; bar: string }> = {
  summit: { tint: 'rgba(15,76,92,0.06)', chip: 'bg-summit/12 text-summit', bar: 'bg-summit' },
  clay: { tint: 'rgba(196,106,75,0.08)', chip: 'bg-clay/15 text-clay', bar: 'bg-clay' },
  amber: { tint: 'rgba(224,164,88,0.12)', chip: 'bg-[#E0A458]/20 text-[#b97c2f]', bar: 'bg-[#E0A458]' },
  sage: { tint: 'rgba(92,123,120,0.10)', chip: 'bg-mist/30 text-summit-deep', bar: 'bg-[#5c7b78]' },
};
---

<Section id="servicios" bg="paper">
  <div class="relative">
    <SectionNumber number="03" class="absolute -top-12 right-0 text-[7rem] sm:text-[10rem]" />

    <div class="relative mb-12 max-w-2xl">
      <p data-reveal class="mb-3 text-sm font-medium uppercase tracking-wider text-clay">
        Nuestros servicios
      </p>
      <h2 data-reveal class="mb-5 text-3xl font-semibold leading-tight sm:text-4xl">
        Cuatro formas de acompañarte
      </h2>
      <p data-reveal class="text-lg leading-relaxed text-ink/75">
        Soluciones simples, prácticas y conectadas con tu realidad, para empresas que crecen,
        cambian o enfrentan nuevos desafíos.
      </p>
    </div>

    <div class="grid gap-5 md:grid-cols-2">
      {
        services.map((s, i) => {
          const a = accentStyles[s.accent];
          return (
            <article
              data-reveal
              data-reveal-stagger={i * 90}
              class="group relative flex flex-col overflow-hidden rounded-2xl border border-line p-7 transition-all duration-300 ease-smooth hover:-translate-y-1 hover:shadow-lift"
              style={`background:${a.tint}`}
            >
              <span class={`absolute inset-x-0 top-0 h-1 ${a.bar}`} />

              <div class="mb-5 flex items-center justify-between">
                <span class={`inline-flex h-12 w-12 items-center justify-center rounded-xl ${a.chip}`}>
                  <Icon name={s.icon} class="h-6 w-6" />
                </span>
                <span class="font-serif text-3xl font-light text-ink/15">{s.number}</span>
              </div>

              <h3 class="mb-2 text-xl font-semibold sm:text-2xl">{s.title}</h3>
              <p class="mb-3 font-serif text-base italic text-ink/70">{s.hook}</p>
              <p class="text-[0.975rem] leading-relaxed text-ink/75">{s.summary}</p>

              <details class="service mt-4">
                <summary class="inline-flex cursor-pointer list-none items-center gap-1.5 text-sm font-medium text-summit">
                  <span class="group-detail-label link-underline">Ver detalle</span>
                  <Icon name="chevron-down" class="h-4 w-4 transition-transform" />
                </summary>
                <p class="mt-3 text-[0.95rem] leading-relaxed text-ink/70">{s.body}</p>
              </details>

              <a
                href="#contacto"
                class="mt-5 inline-flex items-center gap-1.5 text-sm font-medium text-summit link-underline"
              >
                Conversemos
                <Icon name="arrow-right" class="h-4 w-4" />
              </a>
            </article>
          );
        })
      }
    </div>
  </div>
</Section>

<style>
  summary::-webkit-details-marker {
    display: none;
  }
  details[open] summary :global(.lucide),
  details[open] summary svg {
    transform: rotate(180deg);
  }
  @media (prefers-reduced-motion: no-preference) {
    details[open] > p {
      animation: service-open 0.35s var(--ease-smooth);
    }
    @keyframes service-open {
      from {
        opacity: 0;
        transform: translateY(-4px);
      }
      to {
        opacity: 1;
        transform: none;
      }
    }
  }
</style>
