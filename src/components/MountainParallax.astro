---
// Capas de cordillera con parallax (de claro/lejano a oscuro/cercano).
// El JS lee data-parallax-speed y escribe la var CSS --py al hacer scroll.
// `variant`: 'hero' (amanecer cálido) | 'summit' (cumbre oscura para el CTA final).
interface Props {
  variant?: 'hero' | 'summit';
  class?: string;
}
const { variant = 'hero', class: className = '' } = Astro.props;
const isSummit = variant === 'summit';
---

<div class={`pointer-events-none absolute inset-0 overflow-hidden ${className}`} aria-hidden="true">
  {/* Niebla/atmósfera entre montañas */}
  <div
    class="absolute inset-x-0 bottom-0 h-1/2"
    style={
      isSummit
        ? 'background:linear-gradient(to top, rgba(10,54,63,0.65), transparent)'
        : 'background:linear-gradient(to top, rgba(159,184,181,0.35), transparent)'
    }
  >
  </div>

  {/* Capa lejana */}
  <svg
    data-parallax
    data-parallax-speed="0.12"
    class="absolute inset-x-0 bottom-0 w-full"
    viewBox="0 0 1440 320"
    preserveAspectRatio="xMidYMax slice"
    fill="none"
  >
    <path
      d="M0,260 L240,150 L420,220 L640,90 L880,210 L1080,120 L1280,200 L1440,140 L1440,320 L0,320 Z"
      fill={isSummit ? '#13525f' : '#bcd0cd'}
    />
  </svg>

  {/* Capa media */}
  <svg
    data-parallax
    data-parallax-speed="0.26"
    class="absolute inset-x-0 bottom-0 w-full"
    viewBox="0 0 1440 320"
    preserveAspectRatio="xMidYMax slice"
    fill="none"
  >
    <path
      d="M0,300 L200,200 L360,270 L560,160 L760,280 L960,180 L1180,270 L1380,190 L1440,230 L1440,320 L0,320 Z"
      fill={isSummit ? '#0f4654' : '#8aa9a4'}
    />
  </svg>

  {/* Capa cercana (oscura) */}
  <svg
    data-parallax
    data-parallax-speed="0.42"
    class="absolute inset-x-0 bottom-0 w-full"
    viewBox="0 0 1440 320"
    preserveAspectRatio="xMidYMax slice"
    fill="none"
  >
    <path
      d="M0,320 L160,250 L380,300 L600,230 L820,310 L1040,250 L1260,310 L1440,260 L1440,320 Z"
      fill={isSummit ? '#0a363f' : '#5c7b78'}
    />
  </svg>
</div>
