---
import Section from './Section.astro';
import SectionNumber from './SectionNumber.astro';
import Icon from './Icon.astro';
import TestimonialCard from './TestimonialCard.astro';
import { testimonials } from '../data/testimonials';
---

<Section id="testimonios" bg="stone">
  <div class="relative">
    <SectionNumber number="04" class="absolute -top-12 left-0 text-[7rem] sm:text-[10rem]" />

    <div class="relative mb-10 flex flex-wrap items-end justify-between gap-6">
      <div class="max-w-2xl">
        <p data-reveal class="mb-3 text-sm font-medium uppercase tracking-wider text-summit">
          Testimonios
        </p>
        <h2 data-reveal class="text-3xl font-semibold leading-tight sm:text-4xl">
          Lo que dicen quienes ya subieron con nosotros
        </h2>
      </div>

      <!-- Controles -->
      <div data-reveal class="flex gap-2.5">
        <button
          type="button"
          data-slider-prev
          class="inline-flex h-11 w-11 items-center justify-center rounded-full border border-line bg-paper text-summit transition-all hover:border-summit hover:bg-summit hover:text-paper disabled:opacity-40"
          aria-label="Testimonio anterior"
        >
          <Icon name="arrow-right" class="h-5 w-5 rotate-180" />
        </button>
        <button
          type="button"
          data-slider-next
          class="inline-flex h-11 w-11 items-center justify-center rounded-full border border-line bg-paper text-summit transition-all hover:border-summit hover:bg-summit hover:text-paper disabled:opacity-40"
          aria-label="Testimonio siguiente"
        >
          <Icon name="arrow-right" class="h-5 w-5" />
        </button>
      </div>
    </div>

    <!-- Pista deslizable con scroll-snap -->
    <div
      data-slider-track
      data-reveal
      class="-mx-6 flex snap-x snap-mandatory gap-5 overflow-x-auto scroll-smooth px-6 pb-4 sm:-mx-8 sm:px-8 [scrollbar-width:none] [&::-webkit-scrollbar]:hidden"
    >
      {
        testimonials.map((t, i) => (
          <div class="w-[88%] shrink-0 sm:w-[58%] lg:w-[40%]">
            <TestimonialCard {...t} accent={(['summit', 'clay', 'amber', 'sage'] as const)[i % 4]} />
          </div>
        ))
      }
    </div>

    <!-- TODO: reemplazar por logos reales de empresas cuando se provean. -->
  </div>
</Section>

<script>
  function initSlider() {
    const track = document.querySelector<HTMLElement>('[data-slider-track]');
    const prev = document.querySelector<HTMLButtonElement>('[data-slider-prev]');
    const next = document.querySelector<HTMLButtonElement>('[data-slider-next]');
    if (!track || !prev || !next) return;

    const step = () => {
      const card = track.querySelector<HTMLElement>(':scope > div');
      return card ? card.offsetWidth + 20 : track.clientWidth * 0.8;
    };
    const update = () => {
      const max = track.scrollWidth - track.clientWidth - 1;
      prev.disabled = track.scrollLeft <= 1;
      next.disabled = track.scrollLeft >= max;
    };
    prev.addEventListener('click', () => track.scrollBy({ left: -step(), behavior: 'smooth' }));
    next.addEventListener('click', () => track.scrollBy({ left: step(), behavior: 'smooth' }));
    track.addEventListener('scroll', update, { passive: true });
    window.addEventListener('resize', update, { passive: true });
    update();
  }

  // "Leer más / Leer menos" en cada testimonio
  function initQuoteToggles() {
    document.querySelectorAll<HTMLButtonElement>('[data-quote-toggle]').forEach((btn) => {
      const quote = btn.parentElement?.querySelector<HTMLElement>('[data-quote]');
      if (!quote) return;
      // Oculta el botón si el texto no se desborda (cabe completo)
      if (quote.scrollHeight <= quote.clientHeight + 4) {
        btn.style.display = 'none';
        return;
      }
      btn.addEventListener('click', () => {
        const expanded = quote.classList.toggle('is-expanded');
        btn.textContent = expanded ? 'Leer menos' : 'Leer más';
      });
    });
  }

  function init() {
    initSlider();
    initQuoteToggles();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
</script>
