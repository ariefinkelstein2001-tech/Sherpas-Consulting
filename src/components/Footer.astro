---
import Icon from './Icon.astro';

const contactEmail = import.meta.env.PUBLIC_CONTACT_EMAIL ?? 'contacto@sherpasconsulting.cl';
const year = new Date().getFullYear();

const navLinks = [
  { href: '#proposito', label: 'Propósito' },
  { href: '#brujula', label: 'Cómo trabajamos' },
  { href: '#servicios', label: 'Servicios' },
  { href: '#testimonios', label: 'Testimonios' },
  { href: '#recursos', label: 'Recursos' },
  { href: '#contacto', label: 'Contacto' },
];
---

<footer class="border-t border-line bg-stone">
  <div class="container-page py-14">
    <div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-[1.4fr_1fr_1fr]">
      <!-- Marca -->
      <div>
        <a href="#inicio" class="flex items-center gap-2.5 text-ink" aria-label="Sherpas Consulting — inicio">
          <Icon name="mountain" class="h-6 w-6 text-summit" />
          <span class="font-serif text-lg font-semibold tracking-tight">
            Sherpas<span class="text-summit"> Consulting</span>
          </span>
        </a>
        <p class="mt-4 max-w-xs text-sm leading-relaxed text-ink/60">
          Acompañamos a las organizaciones a llegar más lejos, fortaleciendo a las personas que hacen
          posible su crecimiento.
        </p>
      </div>

      <!-- Navegación -->
      <nav aria-label="Navegación del pie">
        <p class="mb-4 text-sm font-semibold text-ink">Navegación</p>
        <ul class="space-y-2.5 text-sm">
          {
            navLinks.map((l) => (
              <li>
                <a href={l.href} class="text-ink/65 transition-colors hover:text-summit">
                  {l.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <!-- Contacto -->
      <div>
        <p class="mb-4 text-sm font-semibold text-ink">Contacto</p>
        <ul class="space-y-3 text-sm">
          <li>
            <a
              href={`mailto:${contactEmail}`}
              class="inline-flex items-center gap-2 text-ink/65 transition-colors hover:text-summit"
            >
              <Icon name="mail" class="h-4 w-4" />
              {contactEmail}
            </a>
          </li>
          <li>
            <!-- TODO: reemplazar por la URL real de LinkedIn -->
            <a
              href="https://www.linkedin.com/"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 text-ink/65 transition-colors hover:text-summit"
            >
              <Icon name="linkedin" class="h-4 w-4" />
              LinkedIn
            </a>
          </li>
          <li class="inline-flex items-center gap-2 text-ink/65">
            <Icon name="map-pin" class="h-4 w-4" />
            Santiago, Chile
          </li>
        </ul>
      </div>
    </div>

    <div
      class="mt-12 flex flex-col items-center justify-between gap-3 border-t border-line pt-6 text-xs text-ink/50 sm:flex-row"
    >
      <p>© {year} Sherpas Consulting. Todos los derechos reservados.</p>
      <p class="font-serif italic text-clay/80">Porque ninguna cima se alcanza sola.</p>
    </div>
  </div>
</footer>
