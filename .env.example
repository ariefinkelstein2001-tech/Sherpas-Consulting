# Endpoint del formulario de contacto.
# Crea un formulario en https://formspree.io y pega aquí tu endpoint.
# Si se deja vacío, el formulario usa un fallback de mailto: (ver ContactForm.astro).
PUBLIC_FORMSPREE_ENDPOINT=

# Email de contacto directo (usado en el fallback mailto: y en el footer).
PUBLIC_CONTACT_EMAIL=contacto@sherpasconsulting.cl
